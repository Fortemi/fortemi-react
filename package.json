{
  "name": "fortemi-react",
  "version": "2026.7.14",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.5",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.3.5",
    "typescript-eslint": "^8.0.0",
    "@playwright/test": "^1.52.0"
  },
  "scripts": {
    "dev": "pnpm --filter @fortemi/standalone dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @fortemi/core test",
    "test:db-table-parity": "pnpm --filter @fortemi/core test:db-table-parity",
    "test:portable-contract": "pnpm --filter @fortemi/core test:portable-contract",
    "test:platform-contract": "node packages/core/scripts/run-platform-contract.mjs",
    "verify:platform-contract-receipt": "node packages/core/scripts/verify-platform-contract-receipt.mjs",
    "test:platform-contract-tools": "pnpm --filter @fortemi/core build && node --test packages/core/scripts/platform-contract-receipt.test.mjs packages/core/scripts/live-server-contract.test.mjs",
    "shard:refresh-v2-authority": "node packages/core/scripts/refresh-knowledge-shard-v2-authority.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "report:bundle": "pnpm --filter @fortemi/standalone report:bundle",
    "test:e2e": "pnpm --filter @fortemi/standalone test:e2e",
    "examples:site": "node examples/scripts/build-site.mjs && node examples/scripts/serve-site.mjs",
    "examples:site:build": "node examples/scripts/build-site.mjs",
    "examples:site:serve": "node examples/scripts/serve-site.mjs",
    "examples:site:e2e": "playwright test --config examples/playwright.config.ts"
  }
}
