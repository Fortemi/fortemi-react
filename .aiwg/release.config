# Fortemi React release configuration.
# Schema: /home/roctinam/dev/aiwg/agentic/code/frameworks/sdlc-complete/schemas/flows/release-config.yaml

version: 1

project:
  name: fortemi-react
  display_name: fortemi-react
  repo_url: https://git.integrolabs.net/roctinam/fortemi-react
  mirror_url: https://github.com/Fortemi/fortemi-react
  npm_package: '@fortemi/react'

version_policy:
  format: calver
  pattern: 'YYYY.M.PATCH'
  tag_prefix: v
  channels:
    stable:
      tag_format: 'v{YYYY}.{M}.{PATCH}'
      require_announcement: false
      require_changelog: true
      require_uat: true
    rc:
      tag_format: 'v{YYYY}.{M}.{PATCH}-rc.{N}'
      require_announcement: false
      require_changelog: false
      require_uat: false
    beta:
      tag_format: 'v{YYYY}.{M}.{PATCH}-beta.{N}'
      require_announcement: false
      require_changelog: false
      require_uat: false
    alpha:
      tag_format: 'v{YYYY}.{M}.{PATCH}-alpha.{N}'
      require_announcement: false
      require_changelog: false
      require_uat: false

gates:
  - name: local-build-test
    hard_stop: true
    steps:
      - id: typecheck
        run: pnpm typecheck
        expect_exit: 0
      - id: lint
        run: pnpm lint
        expect_exit: 0
      - id: core-tests
        run: pnpm test:core
        expect_exit: 0
      - id: build
        run: pnpm build
        expect_exit: 0
      - id: e2e
        run: tools/release/test-e2e.sh
        expect_exit: 0

  - name: ci-green
    hard_stop: true
    tracker: gitea
    owner: Fortemi
    repo: fortemi-react
    timeout_seconds: 900
    poll_interval_seconds: 30
    required_workflows:
      - ci.yml

  - name: doc-sync
    hard_stop: true
    invoke_skill: doc-sync
    args:
      direction: code-to-docs
      scope: 'packages/** apps/** docs/** README.md CHANGELOG.md'
      dry_run_first: true

  - name: release-artifacts
    hard_stop: true
    required_for_channels: [stable]
    artifacts:
      - path: CHANGELOG.md
        section_pattern: '## v{version}'
      - path: 'docs/content/releases/v{version}.md'
        must_exist: true

  - name: release
    hard_stop: true
    steps:
      - id: create-tag
        run: 'tools/release/cut-tag.sh {version}'
        expect_exit: 0
      - id: push-origin
        run: 'git push origin main --tags'
        expect_exit: 0
      - id: push-mirror
        run: 'git push github main --tags'
        expect_exit: 0

policy:
  no_ai_attribution: true
  ci_green_before_done: true
  preserve_pre_release_announcements: false
  thank_external_reporters: true

publication_verify:
  release_assets:
    - 'fortemi-core-{version}.tgz'
    - 'fortemi-graph-{version}.tgz'
    - 'fortemi-react-{version}.tgz'
    - SHA256SUMS
  checksums:
    manifest: SHA256SUMS
    must_cover:
      - 'fortemi-core-{version}.tgz'
      - 'fortemi-graph-{version}.tgz'
      - 'fortemi-react-{version}.tgz'
