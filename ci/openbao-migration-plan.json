{
  "repository": "Fortemi/fortemi-react",
  "reader_approle": "ci-fortemi-react",
  "bootstrap_tracker_secrets": [
    "BAO_CI_ROLE_ID",
    "BAO_CI_SECRET_ID"
  ],
  "tracker_variables": [
    "DEPLOY_HOST",
    "DEPLOY_PORT",
    "DEPLOY_USER",
    "DEPLOY_PATH"
  ],
  "leaves": [
    {
      "mount": "kv_internal",
      "path": "ci/fortemi-react/gitea-publish-token",
      "field": "token",
      "type": "api-token",
      "service": "ci/fortemi-react",
      "owner": "itops",
      "tenant": "internal",
      "purpose": "Gitea package publish and release creation token for Fortemi React",
      "consumers": "gitea-actions:fortemi-react:publish",
      "reader_approle": "ci-fortemi-react",
      "sensitivity": "high",
      "rotation": "quarterly",
      "sop": "itops/docs/openbao-ci-migration.md"
    },
    {
      "mount": "kv_internal",
      "path": "ci/shared/docs-deploy",
      "field": "private_key",
      "type": "ssh-private-key",
      "service": "ci/shared/docs-deploy",
      "owner": "itops",
      "tenant": "internal",
      "purpose": "Shared documentation host deploy SSH private key",
      "consumers": "gitea-actions:fortemi-react:docsite-deploy",
      "reader_approle": "ci-fortemi-react",
      "sensitivity": "critical",
      "rotation": "on-exposure",
      "sop": "itops/docs/openbao-ci-migration.md"
    }
  ],
  "policy": {
    "name": "ci-fortemi-react",
    "rules": [
      {
        "path": "kv_internal/data/ci/fortemi-react/*",
        "capabilities": ["read"]
      },
      {
        "path": "kv_internal/metadata/ci/fortemi-react/*",
        "capabilities": ["read", "list"]
      },
      {
        "path": "kv_internal/data/ci/shared/docs-deploy",
        "capabilities": ["read"]
      },
      {
        "path": "kv_internal/metadata/ci/shared/docs-deploy",
        "capabilities": ["read"]
      }
    ]
  }
}
