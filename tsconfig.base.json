{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@fortemi/core": ["packages/core/src/index.ts"],
      "@fortemi/core/aiwg-index": ["packages/core/src/aiwg-index.ts"],
      "@fortemi/core/worker/pglite-worker": ["packages/core/src/worker/pglite-worker.ts"],
      "@fortemi/core/service-worker/sw": ["packages/core/src/service-worker/sw.ts"],
      "@fortemi/react": ["packages/react/src/index.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
