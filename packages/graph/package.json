{
  "name": "@fortemi/graph",
  "version": "2026.7.7",
  "description": "Framework-agnostic graph tooling for fortemi: pure TypeScript helpers for community-graph layout, filtering, color assignment, degree sizing, bounds/fit, neighborhood expansion, and static snapshot serialization, plus an optional controller subpath for database-backed graph-source selection. No React; consumed by @fortemi/react and JS-only hosts.",
  "keywords": [
    "fortemi",
    "graph",
    "community-detection",
    "graph-layout",
    "knowledge-graph",
    "svg",
    "canvas",
    "visualization"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "AGPL-3.0-only",
  "author": "Joseph Magly <joe@magly.net>",
  "homepage": "https://github.com/Fortemi/fortemi-react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fortemi/fortemi-react.git",
    "directory": "packages/graph"
  },
  "bugs": {
    "url": "https://github.com/Fortemi/fortemi-react/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./controller": {
      "types": "./dist/controller.d.ts",
      "import": "./dist/controller.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@fortemi/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
