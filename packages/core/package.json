{
  "name": "@fortemi/core",
  "version": "2026.7.0",
  "description": "Browser-only knowledge management core: PGlite (PostgreSQL WASM) data layer, single-writer worker, MCP tools, job queue, capability system, SKOS taxonomy, hybrid search. 100% JSON format parity with the fortemi Rust server.",
  "keywords": [
    "fortemi",
    "knowledge-management",
    "pglite",
    "postgresql",
    "wasm",
    "semantic-search",
    "mcp",
    "skos",
    "browser-database"
  ],
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Joseph Magly <joe@magly.net>",
  "homepage": "https://github.com/Fortemi/fortemi-react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fortemi/fortemi-react.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Fortemi/fortemi-react/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./aiwg-index": {
      "types": "./dist/aiwg-index.d.ts",
      "import": "./dist/aiwg-index.js"
    },
    "./worker/pglite-worker": "./dist/worker/pglite-worker.js",
    "./service-worker/sw": "./dist/service-worker/sw.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.1",
    "@noble/hashes": "^1.7.2",
    "fflate": "^0.8.2",
    "uuid": "^13.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.1",
    "tsup": "^8.3.5",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
